#!/usr/bin/env bash

current="$(tmux display-message -p '#S')"

selected=$(
    tmux list-sessions -F "#{session_activity}|#{session_name}" 2>/dev/null \
        | sort -t'|' -k1,1nr \
        | awk -F'|' -v cur="$current" '{
            m = ($2 == cur) ? ">" : " "
            printf "%s\t%s %s\n", $2, m, $2
          }' \
        | fzf \
            --reverse \
            --delimiter='\t' \
            --with-nth=2 \
            --color="header:italic,border:#908caa,pointer:#9ccfd8,marker:#eb6f92" \
            --border=rounded \
            --info=hidden \
            --preview='tmux list-windows -t {1} -F "#{?window_active,>,  } #{window_index}  #{pane_current_command}  [#{window_panes}p]"' \
            --preview-border=left \
            --preview-window=right:40% \
            --bind='ctrl-d:execute-silent(tmux kill-session -t {1})+reload(tmux list-sessions -F "#{session_activity}|#{session_name}" 2>/dev/null | sort -t"|" -k1,1nr | awk -F"|" "{printf \"%s\\t  %s\\n\", \$2, \$2}")' \
            --bind="ctrl-i:become($HOME/.local/bin/tmux-sessionizer)" \
        | awk -F'\t' '{print $1}'
)

[ -z "$selected" ] && exit 0

if [ -n "$TMUX" ]; then
    tmux switch-client -t "$selected"
else
    tmux attach -t "$selected"
fi
