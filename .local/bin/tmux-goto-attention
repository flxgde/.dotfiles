#!/usr/bin/env bash
# Switch straight to the session with the most urgent claude status:
# 🔔 (notify) beats 💡 (waiting) beats 🤖 (busy). Skips the current
# session so repeated presses cycle to the next one needing attention.
# No-op (stays put) if nothing needs attention.

current=$(tmux display-message -p '#S' 2>/dev/null) || exit 0

STATUS_DIR="$HOME/.cache/tmux-claude-status"

all_panes=$(tmux list-panes -a -F '#{session_name} #{pane_id} #{pane_current_command}' 2>/dev/null)

best_session=""
best_pane=""
best_rank=0

while read -r s pane cmd; do
  [ -n "$s" ] || continue
  [ "$s" = "$current" ] && continue
  case "$cmd" in
    zsh|bash|sh|fish|tcsh|ksh) continue ;;
  esac
  state=$(cat "$STATUS_DIR/$pane" 2>/dev/null) || continue
  case "$state" in
    notify)  rank=3 ;;
    waiting) rank=2 ;;
    *)       [ -n "$state" ] && rank=1 || rank=0 ;;
  esac
  [ "$rank" -gt "$best_rank" ] || continue
  best_rank=$rank
  best_session=$s
  best_pane=$pane
done <<<"$all_panes"

if [ -n "$best_session" ]; then
  tmux switch-client -t "$best_session"
  tmux select-pane -t "$best_pane"
fi
