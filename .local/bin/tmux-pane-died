#!/usr/bin/env bash
# Invoked by tmux's `pane-died` hook (requires `remain-on-exit on`).
# Keeps the home session alive by respawning its last pane, and returns
# any clients on another session's last pane to home instead of letting
# tmux detach them when the session dies.

session="$1"
session_windows="$2"
window_panes="$3"
pane_id="$4"

HOME_SESSION="flxg"

if [[ "$session_windows" -ne 1 || "$window_panes" -ne 1 ]]; then
    tmux kill-pane -t "$pane_id"
    exit 0
fi

if [[ "$session" == "$HOME_SESSION" ]]; then
    tmux respawn-pane -k -t "$pane_id"
    exit 0
fi

if ! tmux has-session -t="$HOME_SESSION" 2>/dev/null; then
    tmux new-session -ds "$HOME_SESSION" -c "$HOME"
fi

while read -r client; do
    [[ -n "$client" ]] && tmux switch-client -c "$client" -t "$HOME_SESSION"
done < <(tmux list-clients -t "$session" -F '#{client_name}' 2>/dev/null)

tmux kill-session -t "$session"
