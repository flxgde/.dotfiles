#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
    selected=$1
else
    STATIC_DIRS=$(find ~/code ~/ ~/.config \
        \( -name "node_modules" -o -name ".git" -o -name "target" -o -name ".cache" \) -prune -o \
        -mindepth 1 -maxdepth 2 -type d -print 2>/dev/null)

    Z_DIRS=$(zoxide query -l 2>/dev/null)

    selected=$(printf "%s\n%s\n" "$Z_DIRS" "$STATIC_DIRS" \
        | awk '!seen[$0]++' \
        | fzf \
            --reverse \
            --color="header:italic,border:#908caa,pointer:#9ccfd8,marker:#eb6f92" \
            --border=rounded \
            --ignore-case \
            --info=hidden \
            --preview='
                if [ -d "{}/.git" ]; then
                    git -C {} status -sb 2>/dev/null || tree -C -L 3 {}
                else
                    tree -C -L 3 {}
                fi
            ' \
            --preview-border=left \
            --preview-window=right:50%:wrap)
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

# tmux session IDs ($0, $1, ...) are assigned in creation order and never
# reused, so bootstrapping dotfiles then home first (only on a cold server
# start) is what keeps dotfiles pinned to $0 and home to $1.
if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    dotfiles_name=$(basename "$HOME/.dotfiles" | tr . _)
    home_name=$(basename "$HOME" | tr . _)
    tmux new-session -ds "$dotfiles_name" -c "$HOME/.dotfiles"
    tmux new-session -ds "$home_name" -c "$HOME"
fi

if ! tmux has-session -t="$selected_name" 2>/dev/null; then
    tmux new-session -ds "$selected_name" -c "$selected"
fi

if [[ -z $TMUX ]]; then
    tmux attach -t "$selected_name"
else
    tmux switch-client -t "$selected_name"
fi
