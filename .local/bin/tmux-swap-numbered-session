#!/usr/bin/env bash
# Swap the current session's position with the Nth numbered session (see
# tmux-numbered-sessions), persisting the new order to
# ~/.cache/tmux-session-order. Bound to prefix+S then a digit.

n=$1
[ -n "$n" ] || exit 0

current=$(tmux display-message -p '#S' 2>/dev/null) || exit 0
target=$(~/.local/bin/tmux-numbered-sessions | sed -n "${n}p")
[ -z "$target" ] && exit 0
[ "$target" = "$current" ] && exit 0

ORDER_FILE="$HOME/.cache/tmux-session-order"
~/.local/bin/tmux-session-order >/dev/null

order=()
while IFS= read -r name; do
    order+=("$name")
done <"$ORDER_FILE"

new=()
for name in "${order[@]}"; do
    if [ "$name" = "$current" ]; then
        new+=("$target")
    elif [ "$name" = "$target" ]; then
        new+=("$current")
    else
        new+=("$name")
    fi
done

printf '%s\n' "${new[@]}" >"$ORDER_FILE"
tmux refresh-client -S 2>/dev/null
